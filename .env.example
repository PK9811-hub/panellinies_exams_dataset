# API Configuration (LiteLLM / OpenAI Compatible)
OPENAI_BASE_URL="http://your-llm-server-address:port/v1"
OPENAI_API_KEY="your_api_key_here"
MODEL_ID="your-model-id" 

# Grader / Judge Model Configuration
GRADER_BASE_URL="http://your-grader-server-address:port/v1"
GRADER_API_KEY="your_grader_api_key_here"
GRADER_MODEL_ID="your-grader-model-id"

# Hugging Face Repository Configuration
HF_REPO_ID="your_username/panellinies-exams-dataset-private"
HF_TOKEN="your_hf_token_here"
HF_PRIVATE_REPO=True
HF_GATED_REPO=False

# Local Data Paths
DATA_DIR="./data"
